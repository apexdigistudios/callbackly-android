<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/callbackly_background"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="36dp"
            android:paddingEnd="28dp"
            android:paddingBottom="32dp">

            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:contentDescription="@string/brand_wordmark"
                android:src="@mipmap/ic_launcher"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/brand_wordmark"
                android:textColor="@color/callbackly_accent"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <FrameLayout
                android:id="@+id/pairing_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="42dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/onboarding_title"
                        android:textColor="@color/callbackly_text"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="2dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/onboarding_description"
                        android:textColor="@color/callbackly_muted"
                        android:textSize="16sp"
                        android:lineSpacingExtra="4dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:hint="@string/pairing_code_label"
                        app:boxBackgroundColor="@color/callbackly_surface"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/callbackly_accent">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/pairing_code_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapCharacters|textNoSuggestions"
                            android:maxLines="1"
                            android:imeOptions="actionDone"
                            android:hint="@string/pairing_code_hint"
                            android:textColor="@color/callbackly_text"
                            android:textColorHint="@color/callbackly_muted"
                            android:paddingTop="18dp"
                            android:paddingBottom="18dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/pairing_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/callbackly_error"
                        android:textSize="14sp"
                        android:visibility="gone"
                        tools:text="@string/pairing_error_server"
                        tools:visibility="visible" />

                    <ProgressBar
                        android:id="@+id/pairing_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_marginTop="16dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/callbackly_accent"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/connect_button"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="20dp"
                        android:text="@string/connect_business"
                        android:textAllCaps="false"
                        android:textColor="@color/callbackly_background"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/callbackly_accent"
                        app:cornerRadius="16dp" />

                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/connected_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="70dp"
                android:background="@drawable/callbackly_status_card"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone"
                tools:visibility="visible">

                <View
                    android:id="@+id/status_indicator"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/status_indicator_connected" />

                <TextView
                    android:id="@+id/status_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/connected_status"
                    android:textColor="@color/callbackly_text"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    tools:text="Device Connected &amp; Monitoring Calls" />

                <TextView
                    android:id="@+id/status_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/connected_description"
                    android:textColor="@color/callbackly_muted"
                    android:textSize="15sp"
                    android:lineSpacingExtra="3dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/permission_button"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:text="@string/grant_call_access"
                    android:textAllCaps="false"
                    android:textColor="@color/callbackly_accent"
                    android:visibility="gone"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/callbackly_accent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/disconnect_button"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:text="@string/disconnect_repair"
                    android:textAllCaps="false"
                    android:textColor="@color/callbackly_muted"
                    app:cornerRadius="14dp" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
